{
  "name": "bottle",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:migrate": "pnpm --filter @local-rag/server auth:migrate",
    "setup:api": "bash scripts/python.sh setup",
    "dev:api": "APP_ENV=development bash scripts/python.sh -m uvicorn rag_api.server:app --host 127.0.0.1 --port 8787 --reload --reload-dir apps/api/src --reload-dir packages/rag-core/rag_core",
    "test:api": "bash scripts/python.sh -m pytest -c apps/api/pyproject.toml apps/api/tests",
    "dev:server": "pnpm --filter @local-rag/server dev",
    "dev:web": "pnpm --filter @local-rag/web dev"
  },
  "devDependencies": {
    "concurrently": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "10.18.2"
  }
}
