{
  "name": "@local-rag/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "auth:migrate": "pnpm dlx auth@latest migrate --config src/auth/auth.ts --yes",
    "typecheck": "tsc --noEmit"
