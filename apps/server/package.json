    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
