EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_CACHE_DIR=apps/api/data/models

# Set EMBEDDING_PROVIDER=voyage to use Voyage text embeddings.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# Optional defaults for OpenAI-compatible APIs (personal Settings override these).
# EMBEDDING_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Leave blank to use the model's default dimensions.
OPENAI_EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT_SECONDS=60
